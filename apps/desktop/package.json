{
  "name": "@septcats/desktop",
  "version": "0.6.6",
  "private": true,
  "license": "UNLICENSED",
  "description": "Septcats 桌面壳（Electron + React，electron-vite 三进程脚手架）",
  "author": "Septcats",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-abi.mjs electron && electron-vite dev",
    "build": "node scripts/ensure-abi.mjs electron && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "pretest": "node scripts/ensure-abi.mjs node",
    "test": "vitest run",
    "preselftest": "node scripts/ensure-abi.mjs node",
    "selftest": "node scripts/run-selftest.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/ensure-abi.mjs node",
    "make-icon": "node scripts/make-icon.mjs",
    "dist": "pnpm build && electron-builder --win --config electron-builder.yml",
    "dist:mac": "pnpm build && node scripts/make-icon.mjs && electron-builder --mac --config electron-builder.yml",
    "dist:check": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@septcats/core": "workspace:*",
    "@septcats/dbview": "workspace:*",
    "@septcats/editor": "workspace:*",
    "@septcats/importer": "workspace:*",
    "@septcats/platform": "workspace:*",
    "@septcats/sync": "workspace:*",
    "electron-updater": "6.8.9",
    "@septcats/schema": "workspace:*",
    "@septcats/ui": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "fflate": "0.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26",
    "electron-vite": "^5.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "yjs": "13.6.32"
  }
}
