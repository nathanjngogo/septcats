{
  "name": "@septcats/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Septcats 组件层：DESIGN.md token 管线的唯一消费方（React 18 + 自建组件，不引第三方 UI 库）",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./themes.css": "./src/themes.css",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tokens:build": "node tokens/build-tokens.mjs --write",
    "tokens:check": "node tokens/build-tokens.mjs --check",
    "lint:magic": "node tokens/no-magic.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
